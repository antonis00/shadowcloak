# Copy to .env, which git ignores. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Set to true for local development. It serves uploads and admin styling, and lets
# login cookies work over plain HTTP. Keep it false anywhere that uses HTTPS.
DJANGO_DEBUG=false
# Production only. A comma-separated list of the hostnames this app answers to.
# DJANGO_ALLOWED_HOSTS=example.com
# Production only. Set to true only when a proxy you control sits in front of the app.
# DJANGO_BEHIND_PROXY=true
